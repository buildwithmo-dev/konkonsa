# Core
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Postgres (use the Session Pooler URL for a persistent Render backend)
# Example: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800

# Supabase Auth
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy HS256 projects can use this; newer asymmetric projects can use SUPABASE_JWKS_URL instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
REQUIRE_AUTH=true

# Anthropic
ANTHROPIC_API_KEY=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Konkonsa/1.0

# Optional local-only fallback
AUTO_CREATE_TABLES=false

# X / Twitter ingestion
X_BEARER_TOKEN=
X_SEARCH_QUERY=("AI" OR startup OR "small business" OR "side hustle") lang:en -is:retweet
X_FETCH_MAX_RESULTS=50
X_FETCH_MAX_PAGES=1
