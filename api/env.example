# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database (default: SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./trentradar.db
# For Postgres: postgresql+asyncpg://user:password@localhost:5432/trentradar

# Reddit (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendRadar/1.0

# Redis (optional, for deduplication + queuing)
REDIS_URL=redis://localhost:6379/0
